{
  "name": "cico",
  "version": "0.1.0",
  "private": true,
  "description": "CİCO — FMV interaktif macera: oynanabilir metin demosu (Bölüm 1: Gece Vardiyası)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tools/serve.js",
    "play": "node tools/play-cli.js",
    "test": "node --test tests/",
    "validate": "node tools/validate.js",
    "flow": "node tools/gen-flow.js",
    "artifact": "node tools/build-artifact.js",
    "bible": "node tools/gen-bible.js",
    "www": "node tools/build-www.js",
    "www:offline": "node tools/build-www.js --bundle-videos",
    "cap:sync": "node tools/build-www.js && npx cap sync",
    "android": "node tools/build-www.js && npx cap sync android && npx cap run android",
    "android:apk": "node tools/build-www.js && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
